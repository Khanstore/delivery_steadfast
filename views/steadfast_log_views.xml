<odoo>
    <record id="view_steadfast_log_list" model="ir.ui.view"><field name="name">steadfast.api.log.list</field><field name="model">steadfast.api.log</field><field name="arch" type="xml"><list><field name="create_date"/><field name="carrier_id"/><field name="method"/><field name="endpoint"/><field name="http_status"/><field name="duration"/><field name="error_message"/></list></field></record>
    <record id="view_steadfast_log_form" model="ir.ui.view"><field name="name">steadfast.api.log.form</field><field name="model">steadfast.api.log</field><field name="arch" type="xml"><form><sheet><group><field name="create_date"/><field name="carrier_id"/><field name="method"/><field name="endpoint"/><field name="http_status"/><field name="duration"/></group><notebook><page string="Request"><field name="request_json" widget="text"/></page><page string="Response"><field name="response_json" widget="text"/><field name="error_message" widget="text"/></page></notebook></sheet></form></field></record>
    <record id="action_steadfast_logs" model="ir.actions.act_window"><field name="name">API Logs</field><field name="res_model">steadfast.api.log</field><field name="view_mode">list,form</field></record>
</odoo>
