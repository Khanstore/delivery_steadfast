<odoo>
    <record id="view_steadfast_shipment_list" model="ir.ui.view">
        <field name="name">steadfast.shipment.list</field><field name="model">steadfast.shipment</field><field name="arch" type="xml"><list><field name="name"/><field name="picking_id"/><field name="sale_id"/><field name="partner_id"/><field name="invoice"/><field name="consignment_id"/><field name="tracking_code"/><field name="tracking_link" widget="url"/><field name="cod_amount"/><field name="delivery_charge"/><field name="cod_move_id"/><field name="state"/><field name="return_state"/><field name="last_sync"/><field name="last_webhook_at"/><field name="is_terminal"/><field name="last_webhook_at"/></list></field>
    </record>
    <record id="view_steadfast_shipment_form" model="ir.ui.view">
        <field name="name">steadfast.shipment.form</field><field name="model">steadfast.shipment</field><field name="arch" type="xml"><form><header><button name="action_refresh_status" type="object" string="Refresh Status" class="btn-primary"/><button name="action_tracking_history" type="object" string="Tracking History"/><button name="action_open_picking" type="object" string="Delivery Order"/><button name="action_create_cod_journal_entry" type="object" string="Reflect COD in Journal"/></header><sheet><group><group><field name="name"/><field name="carrier_id"/><field name="picking_id"/><field name="sale_id"/><field name="partner_id"/></group><group><field name="invoice"/><field name="consignment_id"/><field name="tracking_code"/><field name="tracking_link" widget="url"/><field name="cod_amount"/><field name="delivery_charge"/><field name="cod_move_id"/><field name="state"/><field name="return_state"/><field name="last_sync"/><field name="last_webhook_at"/><field name="is_terminal"/><field name="last_webhook_at"/></group></group><notebook><page string="Tracking Events"><field name="tracking_event_ids"><list><field name="event_date"/><field name="status"/><field name="description"/></list></field></page><page string="Last API Response"><field name="last_response" widget="text"/><field name="error_message" widget="text"/></page></notebook></sheet></form></field></record>
    <record id="action_steadfast_shipments" model="ir.actions.act_window"><field name="name">Shipments</field><field name="res_model">steadfast.shipment</field><field name="view_mode">list,form</field></record>
</odoo>
