<odoo>
    <record id="view_steadfast_cod_confirm_wizard" model="ir.ui.view">
        <field name="name">steadfast.cod.confirm.wizard.form</field>
        <field name="model">steadfast.cod.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Steadfast COD">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <field name="warning" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="picking_id"/>
                        <field name="customer_name"/>
                        <field name="order_amount"/>
                        <field name="cod_amount" class="oe_inline"/>
                    </group>
                    <div class="text-muted">
                        This is the amount Steadfast will collect from the customer. Sending is blocked until this amount is confirmed.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm COD Amount" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_steadfast_cod_confirm_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Steadfast COD</field>
        <field name="res_model">steadfast.cod.confirm.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
