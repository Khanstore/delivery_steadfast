<odoo>
    <record id="view_steadfast_return_list" model="ir.ui.view"><field name="name">steadfast.return.request.list</field><field name="model">steadfast.return.request</field><field name="arch" type="xml"><list><field name="name"/><field name="carrier_id"/><field name="shipment_id"/><field name="request_id"/><field name="state"/></list></field></record>
    <record id="view_steadfast_return_form" model="ir.ui.view"><field name="name">steadfast.return.request.form</field><field name="model">steadfast.return.request</field><field name="arch" type="xml"><form><header><button name="action_send" type="object" string="Send Return Request" class="btn-primary"/><button name="action_refresh" type="object" string="Refresh"/><button name="action_load_list" type="object" string="Load Return List"/></header><sheet><group><field name="name"/><field name="carrier_id"/><field name="shipment_id"/><field name="request_id"/><field name="state"/><field name="page"/></group><notebook><page string="Payload"><field name="payload_json" widget="text"/></page><page string="Response"><field name="response_json" widget="text"/></page></notebook></sheet></form></field></record>
    <record id="action_steadfast_returns" model="ir.actions.act_window"><field name="name">Return Requests</field><field name="res_model">steadfast.return.request</field><field name="view_mode">list,form</field></record>
</odoo>
