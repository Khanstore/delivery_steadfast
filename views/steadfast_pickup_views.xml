<odoo>
    <record id="view_steadfast_pickup_list" model="ir.ui.view"><field name="name">steadfast.pickup.request.list</field><field name="model">steadfast.pickup.request</field><field name="arch" type="xml"><list><field name="name"/><field name="carrier_id"/><field name="pickup_location_id"/><field name="sender_name"/><field name="pickup_city"/><field name="state"/></list></field></record>
    <record id="view_steadfast_pickup_form" model="ir.ui.view"><field name="name">steadfast.pickup.request.form</field><field name="model">steadfast.pickup.request</field><field name="arch" type="xml"><form><header><button name="action_generate_payload" type="object" string="Generate Payload"/><button name="action_send" type="object" string="Send Pickup Request" class="btn-primary"/></header><sheet><group><field name="name"/><field name="carrier_id"/><field name="pickup_location_id"/><field name="state" readonly="1"/></group><group string="Pickup From"><field name="sender_name"/><field name="sender_phone"/><field name="sender_email"/><field name="pickup_address"/><field name="pickup_city"/></group><notebook><page string="Payload"><field name="payload_json" widget="text"/></page><page string="Response"><field name="response_json" widget="text"/></page></notebook></sheet></form></field></record>
    <record id="action_steadfast_pickups" model="ir.actions.act_window"><field name="name">Pickup Requests</field><field name="res_model">steadfast.pickup.request</field><field name="view_mode">list,form</field></record>
</odoo>
