<odoo>
    <record id="view_steadfast_tracking_list" model="ir.ui.view">
        <field name="name">steadfast.tracking.event.list</field>
        <field name="model">steadfast.tracking.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="shipment_id"/>
                <field name="event_date"/>
                <field name="status"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="view_steadfast_tracking_form" model="ir.ui.view">
        <field name="name">steadfast.tracking.event.form</field>
        <field name="model">steadfast.tracking.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="shipment_id"/>
                        <field name="event_date"/>
                        <field name="status"/>
                        <field name="description"/>
                        <field name="raw_json" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_steadfast_tracking" model="ir.actions.act_window">
        <field name="name">Tracking History</field>
        <field name="res_model">steadfast.tracking.event</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_steadfast_webhook_event_list" model="ir.ui.view">
        <field name="name">steadfast.webhook.event.list</field>
        <field name="model">steadfast.webhook.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="carrier_id"/>
                <field name="notification_type"/>
                <field name="idempotency_key"/>
                <field name="processed"/>
                <field name="processing_error"/>
            </list>
        </field>
    </record>
    <record id="view_steadfast_webhook_event_form" model="ir.ui.view">
        <field name="name">steadfast.webhook.event.form</field>
        <field name="model">steadfast.webhook.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="carrier_id"/>
                        <field name="notification_type"/>
                        <field name="idempotency_key"/>
                        <field name="processed"/>
                        <field name="processing_error"/>
                    </group>
                    <field name="payload_json" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_steadfast_webhook_events" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">steadfast.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
