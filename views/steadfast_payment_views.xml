<odoo>
    <record id="view_steadfast_payment_list" model="ir.ui.view"><field name="name">steadfast.payment.list</field><field name="model">steadfast.payment</field><field name="arch" type="xml"><list><field name="name"/><field name="carrier_id"/><field name="payment_id"/><field name="payment_date"/><field name="amount"/><field name="journal_entry_id"/><field name="journal_state"/></list></field></record>
    <record id="view_steadfast_payment_form" model="ir.ui.view"><field name="name">steadfast.payment.form</field><field name="model">steadfast.payment</field><field name="arch" type="xml"><form><header><button name="action_refresh" type="object" string="Refresh"/><button name="action_load_list" type="object" string="Load Payment List"/><button name="action_create_journal_entry" type="object" string="Reflect in Journal" class="btn-primary" invisible="journal_entry_id"/></header><sheet><group><field name="name"/><field name="carrier_id"/><field name="payment_id"/><field name="payment_date"/><field name="amount"/><field name="journal_entry_id"/><field name="journal_state"/></group><field name="response_json" widget="text"/></sheet></form></field></record>
    <record id="action_steadfast_payments" model="ir.actions.act_window"><field name="name">Payments / Settlements</field><field name="res_model">steadfast.payment</field><field name="view_mode">list,form</field></record>
</odoo>
